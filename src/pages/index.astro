---
import PrivateLayout from '../layouts/PrivateLayout.astro';
import { deletePrivateCookiesOnly } from '../utils/cookies.ts';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

deletePrivateCookiesOnly(Astro.cookies);
---

<PrivateLayout title='Home' user={user}>
  <h1>Home</h1>
</PrivateLayout>
