---
import PrivateLayout from '../layouts/PrivateLayout.astro';
import { COOKIES_KEY_PUBLIC_SESSION } from '../constants/cookies';
import { deletePublicCookies } from '../utils';

deletePublicCookies(Astro.cookies);

if (!Astro.cookies.has(COOKIES_KEY_PUBLIC_SESSION)) {
  return Astro.redirect('/login');
}
---

<PrivateLayout title='Home'>
  <h1>Home</h1>
</PrivateLayout>
