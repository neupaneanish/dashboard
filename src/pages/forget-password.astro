---
import { actions, isActionError, isInputError } from 'astro:actions';
import PublicLayout from '../layouts/PublicLayout.astro';
import { COOKIES_KEY_SESSION } from '../constants/cookies';

if (Astro.cookies.has(COOKIES_KEY_SESSION)) {
  return Astro.redirect('/');
}

const response = Astro.getActionResult(actions.forgetPassword);

const isPost = Astro.request.method === 'POST';
const values = isPost
  ? (Object.fromEntries(await Astro.request.clone().formData()) as Record<
      string,
      string
    >)
  : ({} as Record<string, string>);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const emailError = isInputError(response?.error)
  ? response.error.fields.email?.[0]
  : undefined;

const serverError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error)
    ? response.error.message
    : undefined;
---

<PublicLayout title='Forget Password'>
  <div class='forget-password'>
    <h2 class='header'>Forget Password</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form class='form' method='post' action={actions.forgetPassword}>
      <div class='form-group'>
        <label for='email'>Email</label>
        <input
          id='email'
          name='email'
          placeholder='Enter an email'
          type='email'
          value={values.email || ''}
          autocomplete='off'
        />
        <div class='errors'>
          {emailError && <span class='error'>{emailError}</span>}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Send email
      </button>
    </form>
    <div class='footer'>
      <div>
        <a class='login' href='/login'>
          Back to Login?
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
