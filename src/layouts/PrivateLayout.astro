---
import '../styles/layouts/private.css';
import Layout from './Layout.astro';
import SideNav from '../components/SideNav.astro';
import { GATEWAY_NAVS, ROOT_NAVS } from '../components/sidenav';
import type { User } from '../utils';

interface Props {
  title: string;
  user: User;
  heading: string;
}
const { title, user, heading } = Astro.props;
---

<Layout title={title}>
  <div class='private'>
    <SideNav navs={user.isRoot ? ROOT_NAVS : GATEWAY_NAVS} />
    <main>
      <h1 class='heading'>{heading}</h1>
      <slot />
    </main>
  </div>
</Layout>
