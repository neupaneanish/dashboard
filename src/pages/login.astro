---
import PublicLayout from '../layouts/PublicLayout.astro';
import {
  COOKIES_KEY_SESSION,
  COOKIES_KEY_SESSION_EXPIRED,
} from '../constants/cookies';
import { actions, isInputError, isActionError } from 'astro:actions';

if (Astro.cookies.has(COOKIES_KEY_SESSION)) {
  return Astro.redirect('/');
}

const sessionExpired = Astro.cookies.get(COOKIES_KEY_SESSION_EXPIRED)?.value;

if (sessionExpired) {
  Astro.cookies.delete(COOKIES_KEY_SESSION_EXPIRED, { path: '/' });
}

const response = Astro.getActionResult(actions.login);

const isPost = Astro.request.method === 'POST';
const values = isPost
  ? (Object.fromEntries(await Astro.request.clone().formData()) as Record<
      string,
      string
    >)
  : ({} as Record<string, string>);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const emailError = isInputError(response?.error)
  ? response.error.fields.email?.[0]
  : undefined;

const passwordError = isInputError(response?.error)
  ? response.error.fields.password?.[0]
  : undefined;

const serverError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error)
    ? response.error.message
    : undefined;
---

<PublicLayout title='Login'>
  <div class='login'>
    <h2 class='header'>Welcome Back</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form id='login-form' class='form' method='post' action={actions.login}>
      <div class='form-group'>
        <label for='email'>Email</label>
        <input
          id='email'
          name='email'
          placeholder='Enter an email'
          type='email'
          value={values.email || ''}
          autocomplete='off'
        />
        <div class='errors'>
          {emailError && <span class='error'>{emailError}</span>}
        </div>
      </div>
      <div class='form-group'>
        <label for='password'>Password</label>
        <input
          id='password'
          name='password'
          placeholder='Enter a password'
          type='password'
          value={values.password || ''}
          autocomplete='off'
        />
        <div class='errors'>
          {passwordError && <span class='error'>{passwordError}</span>}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Login
      </button>
    </form>
    <div class='footer'>
      <div class='stack'>
        <div>
          <a class='register' href='/register'>
            Don't have account? Register
          </a>
        </div>
        <div>
          <a class='forget-password' href='/forget-password'>
            Forget Password?
          </a>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>
