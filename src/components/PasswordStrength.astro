---
interface Props {
  passwordError: string[] | undefined;
}
const { passwordError } = Astro.props;
---

<div class='errors'>
  {passwordError && passwordError.length > 0 ? (
    <ul>
      {passwordError.map(message => (
        <li class='error'>{message}</li>
      ))}
    </ul>
  ) : (
    <ul>
      <li class='hint'>Must be between 8 and 64 characters</li>
      <li class='hint'>Must include at least one lowercase</li>
      <li class='hint'>Must include at least one uppercase</li>
      <li class='hint'>Must include at least one number</li>
      <li class='hint'>Must include at least one special character</li>
    </ul>
  )}
</div>
