---
import { actions, isActionError, isInputError } from 'astro:actions';
import PublicLayout from '../layouts/PublicLayout.astro';
import { COOKIES_KEY_RESET, COOKIES_KEY_SESSION } from '../constants/cookies';
import PasswordStrength from '../components/PasswordStrength.astro';

if (Astro.cookies.has(COOKIES_KEY_SESSION)) {
  return Astro.redirect('/');
}

if (!Astro.cookies.has(COOKIES_KEY_RESET)) {
  return Astro.redirect('/login');
}

const response = Astro.getActionResult(actions.resetPassword);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const isPost = Astro.request.method === 'POST';
const values = isPost
  ? (Object.fromEntries(await Astro.request.clone().formData()) as Record<
      string,
      string
    >)
  : ({} as Record<string, string>);

const passwordError = isInputError(response?.error)
  ? response.error.fields.password
  : undefined;

const confirmPasswordError = isInputError(response?.error)
  ? response.error.fields.confirmPassword?.[0]
  : undefined;

const serverError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error)
    ? response.error.message
    : undefined;
---

<PublicLayout title='Reset Password'>
  <div class='reset-password'>
    <h2 class='header'>Reset Password</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form class='form' method='post' action={actions.resetPassword}>
      <div class='form-group'>
        <label for='password'>Password</label>
        <input
          id='password'
          name='password'
          placeholder='Enter a password'
          type='password'
          value={values?.password || ''}
          autocomplete='off'
        />
        <PasswordStrength passwordError={passwordError} />
      </div>
      <div class='form-group'>
        <label for='confirmPassword'>Confirm Password</label>
        <input
          id='confirmPassword'
          name='confirmPassword'
          placeholder='Enter a confirm password'
          type='password'
          value={values?.confirmPassword || ''}
          autocomplete='off'
        />
        <div class='errors'>
          {confirmPasswordError ? (
            <span class='error'>{confirmPasswordError}</span>
          ) : (
            <span class='hint'>Must match with password</span>
          )}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Reset Password
      </button>
    </form>
    <div class='footer'>
      <div>
        <a class='login' href='/login'>
          Back to Login?
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
