{
  "plugins": [
    "prettier-plugin-astro"
  ],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "singleQuote": true,
        "jsxSingleQuote": true,
        "arrowParens": "avoid",
        "bracketSameLine": false,
        "printWidth": 80,
        "bracketSpacing": true,
        "semi": true,
        "trailingComma": "es5"
      }
    }
  ]
}
