---
import PrivateLayout from '../layouts/PrivateLayout.astro';
import { deletePrivateCookiesOnly } from '../utils/cookies';
import RootHome from '../components/RootHome.astro';
import '../styles/pages/index.css';
import Home from '../components/Home.astro';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

deletePrivateCookiesOnly(Astro.cookies);
---

<PrivateLayout title='Home' user={user} heading='Dashboard'>
  {user.isRoot ? <RootHome /> : <Home />}
</PrivateLayout>
