---
import { getExpiredMessage } from '../utils';
import { COOKIES_KEY_SESSION_EXPIRED } from '../constants';
const expiredMessage = getExpiredMessage(
  Astro.cookies,
  COOKIES_KEY_SESSION_EXPIRED
);
if (expiredMessage) {
  Astro.cookies.delete(COOKIES_KEY_SESSION_EXPIRED, { path: '/' });
}
---

{expiredMessage && (
  <dialog id='session-expired' closedby='none'>
    <div class='dialog'>
      <h2>{expiredMessage.title}</h2>
      <p>{expiredMessage.message}</p>
      <button
        command='close'
        commandfor='session-expired'
        class:list={[
          'btn',
          expiredMessage.success ? 'btn-green' : 'btn-crimson',
        ]}
      >
        OK
      </button>
    </div>
  </dialog>
)}

<script is:inline>
  document.getElementById('session-expired')?.showModal();
</script>
