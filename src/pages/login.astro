---
import PublicLayout from '../layouts/PublicLayout.astro';
import '../styles/pages/login.css';
import { COOKIES_KEY_SESSION } from '../constants/cookies';
import { actions, isInputError, isActionError } from 'astro:actions';

if (Astro.cookies.has(COOKIES_KEY_SESSION)) {
  return Astro.redirect('/');
}

const sessionExpired = Astro.cookies.get('session-expired')?.value;

if (sessionExpired) {
  Astro.cookies.delete('session-expired', { path: '/' });
}

const response = Astro.getActionResult(actions.login);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const emailError = isInputError(response?.error)
  ? response.error.fields.email?.[0]
  : undefined;

const passwordError = isInputError(response?.error)
  ? response.error.fields.password?.[0]
  : undefined;

const serverError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error)
    ? response.error.message
    : undefined;
---

<PublicLayout title='Login'>
  <div class='login'>
    <h2 class='header'>Welcome Back</h2>
    {serverError && (
      <div
        id='error-message'
        class='error-message'
        animate.enter='fade-in-slide'
        animate.leave='fade-out-slide'
      >
        {serverError}
      </div>
    )}
    <form id='login-form' class='form' method='post' action={actions.login}>
      <div class='form-group'>
        <label for='email'>Email</label>
        <input
          id='email'
          name='email'
          placeholder='Enter an email'
          type='email'
        />
        <div class='errors'>
          {emailError && <span class='error'>{emailError}</span>}
        </div>
      </div>
      <div class='form-group'>
        <label for='password'>Password</label>
        <input
          id='password'
          name='password'
          placeholder='Enter a password'
          type='password'
        />
        <div class='errors'>
          {passwordError && <span class='error'>{passwordError}</span>}
        </div>
      </div>
      <button class='btn-primary' type='submit'>
        Login
      </button>
    </form>
    <div class='footer'>
      <div>
        <a class='register' href='/register'>
          Don't have account? Register
        </a>
      </div>
      <div>
        <a class='forget-password' href='/forget-password'>
          Forget Password?
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
