---
import { actions, isInputError, isActionError } from 'astro:actions';
import {
  COOKIES_KEY_SESSION,
  COOKIES_KEY_SESSION_EXPIRED,
  COOKIES_KEY_VERIFICATION,
  COOKIES_KEY_VERIFICATION_METHOD,
} from '../constants/cookies';
import PublicLayout from '../layouts/PublicLayout.astro';
import { VerificationMethod } from '../protobuf/external/authentication/v1/authentication_pb';
import type { Verification } from '../utils';
import { VerificationHeading } from '../utils/heading';

if (Astro.cookies.has(COOKIES_KEY_SESSION)) {
  return Astro.redirect('/');
}

const cookies: Verification | undefined = Astro.cookies
  .get(COOKIES_KEY_VERIFICATION)
  ?.json();

if (
  Astro.cookies.has(COOKIES_KEY_SESSION_EXPIRED) ||
  !(cookies && cookies.session && cookies.method && cookies.expires)
) {
  return Astro.redirect('/login');
}

let method = Astro.cookies.get(COOKIES_KEY_VERIFICATION_METHOD)?.value;

if (cookies.method === VerificationMethod.TWO_FACTOR && !method) {
  method = 'totp';
}

let hint: string = '';

const methodValue = (() => {
  switch (cookies.method) {
    case VerificationMethod.TWO_FACTOR:
      switch (method) {
        case 'recovery':
          hint = 'Enter a 10 digits code from your recovery';
          return 'recovery';
        case 'totp':
          hint = 'Enter a 6 digits code from authenticator app';
          return 'totp';
        default:
          return '';
      }
    case VerificationMethod.ACCOUNT:
    case VerificationMethod.EMAIL:
    case VerificationMethod.RESET:
      hint = 'Enter a 8 digits code from your email';
      return 'email';
    default:
      return '';
  }
})();

const heading = VerificationHeading(cookies.method);

if (methodValue === '' || heading === 'Verification') {
  return Astro.redirect('/login');
}

const response = Astro.getActionResult(actions.external.verification);
const resendResponse = Astro.getActionResult(actions.external.resend);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const structuralError =
  (response?.error && !isInputError(response.error)
    ? response.error
    : undefined) || resendResponse?.error;

const serverError =
  structuralError && isActionError(structuralError)
    ? structuralError.message
    : undefined;

const codeError = isInputError(response?.error)
  ? response.error.fields.code?.[0]
  : undefined;
---

<PublicLayout title='Verification'>
  <div class='verification'>
    <h2 class='header'>{heading}</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form class='form' method='post' action={actions.external.verification}>
      <input type='hidden' name='method' value={methodValue} />
      <div class='form-group'>
        <label for='code'>Code</label>
        <input
          id='code'
          name='code'
          placeholder='Enter a code'
          type='text'
          autocomplete='off'
        />
        <div class='errors'>
          {codeError ? (
            <span class='error'>{codeError}</span>
          ) : (
            <span class='hint'>{hint}</span>
          )}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Verify
      </button>
    </form>
    <div style='margin: 1rem 0'>
      {cookies.method === VerificationMethod.TWO_FACTOR ? (
        <form method='post' action={actions.external.verificationMethod}>
          <input
            type='hidden'
            name='currentTarget'
            value={methodValue as 'totp' | 'recovery'}
          />
          <button class='btn btn-green-link' type='submit'>
            {methodValue === 'totp' ? 'Use recovery' : 'Use authenticator'}
          </button>
        </form>
      ) : (
        <form method='post' action={actions.external.resend}>
          <button id='resend-btn' class='btn btn-orange' type='submit'>
            Resend Code
          </button>
        </form>
      )}
    </div>
    <div class='footer'>
      <div>
        <a class='login' href='/login'>
          Back to Login?
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
