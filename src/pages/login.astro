---
import PublicLayout from '../layouts/PublicLayout.astro';
import { actions, isInputError, isActionError } from 'astro:actions';
import { deletePublicCookiesOnly } from '../utils/cookies';

const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/');
}

deletePublicCookiesOnly(Astro.cookies);

const response = Astro.getActionResult(actions.external.login);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const emailError = isInputError(response?.error)
  ? response.error.fields.email?.[0]
  : undefined;

const passwordError = isInputError(response?.error)
  ? response.error.fields.password?.[0]
  : undefined;

const serverError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error)
    ? response.error.message
    : undefined;
---

<PublicLayout title='Login'>
  <div class='login'>
    <h2 class='header'>Welcome Back</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form
      id='login-form'
      class='form'
      method='post'
      action={actions.external.login}
    >
      <div class='form-group'>
        <label for='email'>Email</label>
        <input
          id='email'
          name='email'
          placeholder='Enter an email'
          type='email'
          transition:persist
          autocomplete='off'
        />
        <div class='errors'>
          {emailError && <span class='error'>{emailError}</span>}
        </div>
      </div>
      <div class='form-group'>
        <label for='password'>Password</label>
        <input
          id='password'
          name='password'
          placeholder='Enter a password'
          type='password'
          transition:persist
          autocomplete='off'
        />
        <div class='errors'>
          {passwordError && <span class='error'>{passwordError}</span>}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Login
      </button>
    </form>
    <div class='footer'>
      <div class='stack'>
        <div>
          <a class='register' href='/register'>
            Don't have account? Register
          </a>
        </div>
        <div>
          <a class='forgot-password' href='/forgot-password'>
            Forgot Password?
          </a>
        </div>
      </div>
    </div>
  </div>
</PublicLayout>
