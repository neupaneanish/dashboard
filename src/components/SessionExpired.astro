---
import type { SessionExpired } from '../utils';
interface Props {
  sessionExpired: SessionExpired | undefined;
}
const { sessionExpired } = Astro.props;
---

{sessionExpired && (
  <dialog id='session-expired' closedby='none'>
    <div class='dialog'>
      <h2>{sessionExpired.title}</h2>
      <p>{sessionExpired.message}</p>
      <button
        command='close'
        commandfor='session-expired'
        class:list={[
          'btn',
          sessionExpired.success ? 'btn-green' : 'btn-crimson',
        ]}
      >
        OK
      </button>
    </div>
  </dialog>
)}
