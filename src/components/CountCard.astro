---
import type { AstroComponent } from '@tabler/icons-astro';
interface Props {
  count: bigint;
  name: string;
  icon: AstroComponent;
}

const { count, name, icon: Icon } = Astro.props;
---

<div class='count-card'>
  <Icon size={60} />
  <div class='details'>
    <h2>{count.toString()}</h2>
    <p>{name}</p>
  </div>
</div>
