---
import { actions, isActionError, isInputError } from 'astro:actions';
import PublicLayout from '../layouts/PublicLayout.astro';
import { COOKIES_KEY_RESET_PASSWORD, COOKIES_KEY_SESSION } from '../constants';
import PasswordStrength from '../components/PasswordStrength.astro';

if (Astro.locals.user) {
  return Astro.redirect('/');
}

if (!Astro.cookies.has(COOKIES_KEY_RESET_PASSWORD)) {
  return Astro.redirect('/login');
}

const response = Astro.getActionResult(actions.external.resetPassword);

const passwordError = isInputError(response?.error)
  ? response.error.fields.password
  : undefined;

const confirmPasswordError = isInputError(response?.error)
  ? response.error.fields.confirmPassword?.[0]
  : undefined;

const serverError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error)
    ? response.error.message
    : undefined;
---

<PublicLayout title='Reset Password'>
  <div class='reset-password'>
    <h2 class='header'>Reset Password</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form class='form' method='post' action={actions.external.resetPassword}>
      <div class='form-group'>
        <label for='password'>Password</label>
        <input
          id='password'
          name='password'
          placeholder='Enter a password'
          type='password'
          transition:persist
          autocomplete='off'
        />
        <PasswordStrength passwordError={passwordError} />
      </div>
      <div class='form-group'>
        <label for='confirmPassword'>Confirm Password</label>
        <input
          id='confirmPassword'
          name='confirmPassword'
          placeholder='Enter a confirm password'
          type='password'
          transition:persist
          autocomplete='off'
        />
        <div class='errors'>
          {confirmPasswordError ? (
            <span class='error'>{confirmPasswordError}</span>
          ) : (
            <span class='hint'>Must match with password</span>
          )}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Reset Password
      </button>
    </form>
    <div class='footer'>
      <div>
        <a class='login' href='/login'>
          Back to Login?
        </a>
      </div>
    </div>
  </div>
</PublicLayout>
