---
import {
  actions,
  isInputError,
  isActionError,
  ActionError,
} from 'astro:actions';
import {
  COOKIES_KEY_RESET,
  COOKIES_KEY_SESSION,
  COOKIES_KEY_SESSION_EXPIRED,
  COOKIES_KEY_VERIFICATION,
  COOKIES_KEY_VERIFICATION_METHOD,
} from '../constants/cookies';
import PublicLayout from '../layouts/PublicLayout.astro';
import { VerificationMethod } from '../protobuf/external/authentication/v1/authentication_pb';
import { parsedVerification, setCookiesPage } from '../utils';

Astro.cookies.delete(COOKIES_KEY_RESET, { path: '/' });

if (Astro.cookies.has(COOKIES_KEY_SESSION)) {
  return Astro.redirect('/');
}

const sessionCookies = Astro.cookies.get(COOKIES_KEY_VERIFICATION)?.value;

if (!sessionCookies || Astro.cookies.has(COOKIES_KEY_SESSION_EXPIRED)) {
  return Astro.redirect('/login');
}

const cookies = parsedVerification(sessionCookies);

if (!cookies) {
  return Astro.redirect('/login');
}

let method = Astro.cookies.get(COOKIES_KEY_VERIFICATION_METHOD)?.value;

if (cookies.method === VerificationMethod.TWO_FACTOR && !method) {
  method = 'totp';
  setCookiesPage(
    Astro.cookies,
    COOKIES_KEY_VERIFICATION_METHOD,
    'totp',
    cookies.expires
  );
}

let hint: string = '';

const methodValue = (() => {
  switch (cookies.method) {
    case VerificationMethod.TWO_FACTOR:
      switch (method) {
        case 'recovery':
          hint = 'Enter a 10 digits code from your recovery';
          return 'recovery';
        case 'totp':
          hint = 'Enter a 6 digits code from authenticator app';
          return 'totp';
        default:
          return '';
      }
    case VerificationMethod.ACCOUNT:
    case VerificationMethod.EMAIL:
    case VerificationMethod.RESET:
      hint = 'Enter a 8 digits code from your email';
      return 'email';
    default:
      return '';
  }
})();

const heading = (() => {
  switch (cookies.method) {
    case VerificationMethod.ACCOUNT:
      return 'Account Verification';
    case VerificationMethod.EMAIL:
      return 'Email Verification';
    case VerificationMethod.RESET:
      return 'Reset Verification';
    case VerificationMethod.TWO_FACTOR:
      return '2FA Verification';
    default:
      return '';
  }
})();

if (method === '' || heading === '') {
  return Astro.redirect('/login');
}

const response = Astro.getActionResult(actions.external.verification);
const resendResponse = Astro.getActionResult(actions.external.resend);

if (response?.data) {
  return Astro.redirect(response.data.next);
}

const isVerificationError =
  response?.error &&
  isActionError(response.error) &&
  !isInputError(response.error) &&
  response.error.code === 'EXPECTATION_FAILED';

const isResendError =
  resendResponse?.error &&
  isActionError(resendResponse.error) &&
  !isInputError(resendResponse.error) &&
  resendResponse.error.code === 'EXPECTATION_FAILED';

if (isVerificationError || isResendError) {
  setCookiesPage(
    Astro.cookies,
    COOKIES_KEY_SESSION_EXPIRED,
    'Verification',
    new Date(Date.now() + 60000)
  );
  return Astro.redirect('/login');
}

const structuralError =
  (response?.error && !isInputError(response.error)
    ? response.error
    : undefined) || resendResponse?.error;

const serverError =
  structuralError && isActionError(structuralError)
    ? structuralError.message
    : undefined;

const codeError = isInputError(response?.error)
  ? response.error.fields.code?.[0]
  : undefined;

const TOTAL_LIFESPAN = 300;
const COOLDOWN_DURATION = 120;
const BLOCK_THRESHOLD = TOTAL_LIFESPAN - COOLDOWN_DURATION;

const currentTimestampUTC = Math.floor(Date.now() / 1000);
const serverExpirySeconds = Math.floor(cookies.expires.getTime() / 1000);

const secondsUntilSessionExpires = serverExpirySeconds - currentTimestampUTC;

let remainingSeconds: number;

if (
  secondsUntilSessionExpires > BLOCK_THRESHOLD &&
  secondsUntilSessionExpires <= TOTAL_LIFESPAN
) {
  remainingSeconds = secondsUntilSessionExpires - BLOCK_THRESHOLD;
} else {
  remainingSeconds = 0;
}

const isResendActive = remainingSeconds > 0;
const resendInitText = `Resend in ${remainingSeconds}s`;
---

<PublicLayout title='Verification'>
  <div class='verification'>
    <h2 class='header'>{heading}</h2>
    {serverError && (
      <div class='error-message'>
        <p>{serverError}</p>
      </div>
    )}
    <form class='form' method='post' action={actions.external.verification}>
      <input type='hidden' name='method' value={method} />
      <div class='form-group'>
        <label for='code'>Code</label>
        <input
          id='code'
          name='code'
          placeholder='Enter a code'
          type='text'
          autocomplete='off'
        />
        <div class='errors'>
          {codeError ? (
            <span class='error'>{codeError}</span>
          ) : (
            <span class='hint'>{hint}</span>
          )}
        </div>
      </div>
      <button class='btn btn-blue' type='submit'>
        Verify
      </button>
    </form>
    <div style='margin: 1rem 0'>
      {cookies.method === VerificationMethod.TWO_FACTOR ? (
        <form method='post' action={actions.external.verificationMethod}>
          <input
            type='hidden'
            name='currentTarget'
            value={methodValue as 'totp' | 'recovery'}
          />
          <button class='btn btn-green-link' type='submit'>
            {methodValue === 'totp' ? 'Use recovery' : 'Use authenticator'}
          </button>
        </form>
      ) : (
        <form method='post' action={actions.external.resend}>
          <button
            id='resend-btn'
            class='btn btn-orange'
            type='submit'
            disabled={isResendActive}
            data-countdown={remainingSeconds}
          >
            {isResendActive ? resendInitText : 'Resend Code'}
          </button>
        </form>
      )}
    </div>
    <div class='footer'>
      <div>
        <a class='login' href='/login'>
          Back to Login?
        </a>
      </div>
    </div>
  </div>
</PublicLayout>

<script is:inline>
  (function () {
    const btn = document.getElementById('resend-btn');
    if (!btn) return;

    let secondsLeft = parseInt(btn.dataset.countdown, 10);

    if (isNaN(secondsLeft) || secondsLeft <= 0) {
      btn.disabled = false;
      btn.textContent = 'Resend Code';
      return;
    }

    const interval = setInterval(() => {
      secondsLeft--;

      if (secondsLeft <= 0) {
        clearInterval(interval);
        btn.disabled = false;
        btn.textContent = 'Resend Code';
      } else {
        btn.textContent = `Resend in ${secondsLeft}s`;
      }
    }, 1000);
  })();
</script>
